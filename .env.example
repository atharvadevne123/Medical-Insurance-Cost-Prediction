# Copy this file to .env and fill in real values before running
# Never commit .env to version control

# Application
APP_ENV=development           # development | production | test
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# API Server
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1             # Increase to CPU count in production

# Model
MODEL_PATH=models/model.joblib   # Path to serialised model (optional)
DATA_PATH=                        # Override default insurance.csv path (optional)
